root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.{cpp,h,pro,pri}]
end_of_line = crlf

[{include/laserWeldSDK/cl_api.h,include/laserWeldSDK/clmath.h,src/clmath.cpp,src/craftscript.cpp}]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false
